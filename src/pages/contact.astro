---
import BaseLayout from "@layouts/BaseLayout.astro";
import Mail from "@lucide/astro/icons/mail";
import Github from "simple-icons/icons/github.svg";
---
<BaseLayout title="Contact — YOUR NAME" description="Get in touch with YOUR NAME.">
  <section class="container-shell max-w-4xl py-20 sm:py-32">
    <div class="neu-panel p-8 sm:p-12">
      <p class="eyebrow">CONTACT / SAY HELLO</p>
      <h1 class="mt-6 text-5xl font-extrabold leading-tight tracking-[-.065em] sm:text-7xl">Let's start a<br /><span class="text-teal-700">conversation.</span></h1>
      <p class="body-copy mt-7 max-w-xl">制作物についての質問、技術交流、コラボレーションなど、お気軽にご連絡ください。</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="mailto:nashwork255@gmail.com" class="neu-button neu-button-primary">Email me <Mail size={16} aria-hidden="true" /></a>
        <a href="https://github.com/" target="_blank" rel="noreferrer" class="neu-button">GitHub <Github fill="currentColor" aria-hidden="true" width={16} height={16} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
