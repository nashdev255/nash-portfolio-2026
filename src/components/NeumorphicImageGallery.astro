
---
import NeumorphicImage from "./NeumorphicImage.astro";

interface Props {
  columns?: 2 | 3 | 4;
}

const { columns = 3 } = Astro.props;
---

<div class={`image-gallery columns-${columns}`}>
  <slot />
</div>

<style>
  .image-gallery {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  .columns-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .columns-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .columns-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .image-gallery :global(figure) {
    margin: 0;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .image-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
