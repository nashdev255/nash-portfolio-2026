---
interface Props { date: Date; category: string; readingTime?: number; }
const { date, category, readingTime = 5 } = Astro.props;
---
<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-stone-500">
  <time datetime={date.toISOString()}>{date.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" })}</time>
  <span aria-hidden="true">·</span>
  <span>{category}</span>
  <span aria-hidden="true">·</span>
  <span>{readingTime} min read</span>
</div>
