---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArticleMeta from "@components/article/ArticleMeta.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;
const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Articles — YOUR NAME" description="Technical articles, development logs, and notes.">
  <section class="container-shell py-16 sm:py-24">
    <p class="eyebrow">WRITING / ARTICLES</p>
    <h1 class="page-heading">Notes &<br /><span class="accent">articles.</span></h1>
    <p class="body-copy mt-6 max-w-xl">技術的な学び、開発の記録、試行錯誤の過程をまとめています。</p>
    <div class="neu-panel mt-12 divide-y divide-[#d1d8e2] px-6 sm:px-9">
      {articles.map((article) => (
        <a href={`${base}articles/${article.id}/`} class="group grid gap-3 py-6 sm:grid-cols-[150px_1fr_auto] sm:items-start">
          <time class="pt-1 font-mono text-xs text-muted">{article.data.pubDate.toLocaleDateString("ja-JP")}</time>
          <div><div class="mb-2"><ArticleMeta date={article.data.pubDate} category={article.data.category} /></div><h2 class="text-lg font-bold tracking-tight text-ink transition group-hover:text-[#5545a5]">{article.data.title}</h2><p class="mt-2 text-sm leading-7 text-muted">{article.data.description}</p><ul class="mt-3 flex flex-wrap gap-2">{article.data.tags.map((tag) => <li class="text-[11px] text-muted">#{tag}</li>)}</ul></div>
          <span aria-hidden="true" class="text-[#5545a5] transition group-hover:translate-x-1">↗</span>
        </a>
      ))}
    </div>
    {articles.length === 0 && <p class="neu-inset mt-8 p-8 text-sm text-muted">src/content/articles/ にMDXファイルを追加してください。</p>}
  </section>
</BaseLayout>
