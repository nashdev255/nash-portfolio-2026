---
interface Props { eyebrow: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<div class="mb-9 max-w-2xl">
  <p class="eyebrow mb-3">{eyebrow}</p>
  <h2 class="text-balance text-3xl font-extrabold tracking-tighter text-ink sm:text-4xl">{title}</h2>
  {description && <p class="body-copy mt-4 max-w-xl">{description}</p>}
</div>
