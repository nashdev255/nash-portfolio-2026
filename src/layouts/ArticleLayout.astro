---
import BaseLayout from "./BaseLayout.astro";
import ArticleMeta from "@components/article/ArticleMeta.astro";
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  readingTime?: number;
  tags?: string[];
}
const { title, description, pubDate, category, readingTime, tags = [] } = Astro.props;
---
<BaseLayout title={`${title} — Articles`} description={description}>
  <article class="container-shell grid max-w-6xl gap-10 py-14 lg:grid-cols-[minmax(0,760px)_220px] lg:py-20">
    <div class="min-w-0">
      <a href={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}articles/`} class="neu-button mb-8">← All articles</a>
      <header class="neu-panel mb-10 p-7 sm:p-10">
        <p class="eyebrow mb-4">ARTICLE / {category}</p>
        <h1 class="text-balance text-3xl font-extrabold leading-tight tracking-tighter text-ink sm:text-5xl">{title}</h1>
        <p class="body-copy mt-5 max-w-2xl">{description}</p>
        <div class="mt-6"><ArticleMeta date={pubDate} category={category} readingTime={readingTime} /></div>
        {tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2">{tags.map((tag) => <li class="neu-chip">#{tag}</li>)}</ul>}
      </header>
      <div class="prose-content px-1 sm:px-3"><slot /></div>
      <div class="mt-16"><a href={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}articles/`} class="neu-button">← 記事一覧に戻る</a></div>
    </div>
    <aside class="hidden lg:block"><div class="neu-inset sticky top-28 p-5"><p class="eyebrow">ON THIS PAGE</p><p class="mt-3 text-xs leading-6 text-muted">目次</p></div></aside>
  </article>
</BaseLayout>
