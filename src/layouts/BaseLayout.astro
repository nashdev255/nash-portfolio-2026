---
import "@styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Nash - Developer",
  description = "A portfolio of selected projects, notes, and experiments.",
} = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/works/", label: "Works" },
  { href: "/articles/", label: "Articles" },
  { href: "/uses/", label: "Uses" },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e9edf3" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="container-shell header-inner">
        <a href={base} class="brand">
          <span class="brand-mark" aria-hidden="true">N</span>
          <span class="brand-name">2026<span>🦑</span></span>
        </a>
        <nav aria-label="メインナビゲーション" class="primary-nav">
          {nav.map((item) => (
            <a
              href={`${base}$/{item.href.replace(/^\//, "")}`}
              aria-current={currentPath === item.href.replace(/\/$/, "") ? "page" : undefined}
              class:list={["nav-link", currentPath === item.href.replace(/\/$/, "") && "is-active"]}
            >{item.label}</a>
          ))}
        </nav>
        <a href={`${base}/contact/`} class="neu-button neu-button-primary header-cta">
          お問い合わせ <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container-shell footer-inner">
        <div>
          <a href={base} class="footer-brand">NASHDEV255</a>
          <p class="footer-note">Thoughtfully created with Astro.</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/nashdev255" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={`${base}/contact/`}>お問い合わせ</a>
        </div>
        <p class="copyright">{new Date().getFullYear()} © nashdev255</p>
      </div>
    </footer>
  </body>
</html>
