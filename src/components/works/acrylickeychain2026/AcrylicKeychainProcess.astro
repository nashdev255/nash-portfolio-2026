
---
const steps = [
  {
    title: "イラストの製作",
    description:
      "アクリルキーホルダーの元となるイラストを製作する。",
  },
  {
    title: "SVG形式への変換",
    description:
      "製作したイラストを、レーザー加工に適したSVG形式に変換する。",
  },
  {
    title: "専用ソフトウェアへのインポート",
    description:
      "変換したSVGファイルをレーザー加工機専用のソフトウェアにインポートする。",
  },
  {
    title: "ジョブの作成",
    description:
      "穴の作成、サイズ調整、カットラインの作成、左右反転などの処理を施し、加工用のジョブを作成する。",
  },
  {
    title: "キューの作成",
    description:
      "位置設定、材料設定、彫刻・カット設定を行い、加工する内容をキューに登録する。",
  },
  {
    title: "アクリル板の加工",
    description:
      "レーザー加工機にアクリル板をセットし、加工を実行する。",
  },
  {
    title: "仕上げ処理",
    description:
      "レーザー加工で発生した粉を除去し、カット加工で開けた穴にチェーンを通す。",
  },
  {
    title: "加工機の清掃",
    description:
      "加工終了後、レーザー加工機を清掃する。",
  },
];
---

<section class="process" aria-labelledby="process-title">
  <div class="preparation">
    <div class="preparation-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M12 3L21 19H3L12 3Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        />
        <path
          d="M12 9V13"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
        <circle cx="12" cy="16" r="0.8" fill="currentColor" />
      </svg>
    </div>
    <div class="preparation-content">
      <span class="preparation-label">PREPARATION</span>
      <h3>事前準備</h3>
      <p>
        製作を始める前に、レーザー加工機のメンテナンスを済ませておく。
        フィルターの交換やレンズの清掃などを行う。
      </p>
    </div>
  </div>

  <div class="timeline">
    {steps.map((step, index) => (
      <article class="step">
        <div class="step-marker" aria-hidden="true">
          <span>{String(index + 1).padStart(2, "0")}</span>
        </div>

        <div class="step-card">
          <span class="step-number">
            STEP {String(index + 1).padStart(2, "0")}
          </span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="completion">
    <span class="completion-mark" aria-hidden="true">✓</span>
    <div>
      <span class="completion-label">COMPLETED</span>
      <h3>製作完了</h3>
      <p>アクリルキーホルダーの製作プロセスが完了。</p>
    </div>
  </div>
</section>

<style>
  .process {
    --surface: #e9edf3;
    --text: #303b4d;
    --muted: #596477;
    --accent: #007568;
    --shadow-light: #ffffff;
    --shadow-dark: #c5cbd5;

    color: var(--text);
    width: 100%;
    margin: 2rem 0;
  }

  .process-header {
    margin-bottom: 2rem;
  }

  .process-eyebrow,
  .preparation-label,
  .step-number,
  .completion-label {
    display: block;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .process-header h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    font-weight: 750;
    line-height: 1.5;
  }

  .process-header p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .preparation,
  .step-card,
  .completion {
    background: var(--surface);
    border-radius: 1.25rem;
    box-shadow:
      7px 7px 15px var(--shadow-dark),
      -7px -7px 15px var(--shadow-light);
  }

  .preparation {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    margin-bottom: 2rem;
    border: 1px solid rgb(255 255 255 / 35%);
  }

  .preparation-icon {
    display: grid;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: var(--accent);
    border-radius: 50%;
    box-shadow:
      inset 3px 3px 6px var(--shadow-dark),
      inset -3px -3px 6px var(--shadow-light);
  }

  .preparation-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .preparation h3,
  .step-card h3,
  .completion h3 {
    margin: 0.35rem 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .preparation p,
  .step-card p,
  .completion p {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.8;
  }

  .preparation-content {
    min-width: 0;
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0 0 0 1rem;
  }

  .timeline::before {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 2.375rem;
    width: 2px;
    background: var(--shadow-dark);
    content: "";
  }

  .step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    min-width: 0;
  }

  .step-marker {
    position: relative;
    z-index: 1;
    display: grid;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 50%;
    background: var(--surface);
    box-shadow:
      4px 4px 8px var(--shadow-dark),
      -4px -4px 8px var(--shadow-light);
  }

  .step-marker span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 750;
  }

  .step-card {
    flex: 1;
    min-width: 0;
    padding: 1.1rem 1.25rem;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .step-card:hover {
    transform: translateY(-2px);
    box-shadow:
      9px 9px 18px var(--shadow-dark),
      -9px -9px 18px var(--shadow-light);
  }

  .completion {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.25rem;
  }

  .completion-mark {
    display: grid;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 800;
    border-radius: 50%;
    box-shadow:
      inset 3px 3px 6px var(--shadow-dark),
      inset -3px -3px 6px var(--shadow-light);
  }

  @media (max-width: 480px) {
    .preparation,
    .completion {
      padding: 1rem;
    }

    .timeline {
      padding-left: 0.25rem;
      gap: 1rem;
    }

    .timeline::before {
      left: 1.625rem;
    }

    .step {
      gap: 0.85rem;
    }

    .step-marker {
      flex-basis: 2.75rem;
    }

    .step-card {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-card {
      transition: none;
    }

    .step-card:hover {
      transform: none;
    }
  }
</style>
